@model BlogApp.Models.Post
@{
    ViewBag.Title = Model.Title;
}

<style>
    .content-wrapper {
        padding: 20px;
        max-width: 1000px;
        margin: 0 auto;
        font-family: sans-serif;
    }

    .feature-image{
        width: 100%;
        height: 1000px;
        margin-bottom: 20px;
        object-fit: cover;
        
    }
</style>

@if(User.IsInRole("Admin")){
<div class="text-end">
    <a class="btn btn-secondary my-3" asp-action="Edit" asp-controller="Post" asp-route-id ="@Model.Id" >Edit</a>
    <a class="btn btn-danger mx-3 my-3" asp-action="Delete" asp-controller="Post" asp-route-id ="@Model.Id" >Delete</a>
</div>
}

<div class="content-wrapper">
    <h2>@Model.Title</h2>
    <p><span class="badge bg-primary">By:</span>@Model.Author | <span class="badge bg-primary">Published On</span>@Model.PublishedDate.ToString("MMMM dd, yyyy")</p>
        <p><span class="badge bg-secondary">Category:</span>@Model.Category.Name</p>
        <img src="@Model.FeatureImagePath" alt="@Model.Title" class="feature-image" />

        <hr />

        <div>
            @Html.Raw(Model.Content)
</div>
    <hr />
    @if (Model.Comments.Any())
    {
        <div id="comments-section">
            @foreach (var comment in Model.Comments)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@comment.UserName</h5>
                        <p class="card-text text-muted">@comment.CommentDate</p>
                        <p class="card-text">@comment.Content</p>
                </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No comments yet.</p>
    }

    @if(User.Identity.IsAuthenticated){
    <h5>Add a Comment</h5>
    <form id="commentForm" >
        <div class="form-group">
            <label for="UserName">Name</label>
            <input type="text" required class="form-control" id="UserName" name="UserName" />
        </div>
        <div class="form-group">
            <label for="Content">Content</label>
            <textarea required class="form-control" rows="3" id="Content" name="Content"></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-2 rounded p-2">Submit Comment</button>
</form>
}
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            $("#commentForm").on("submit", function(event) {
                event.preventDefault();

                var userName = $("#UserName").val();
                var content = $("#Content").val();
                var postId = @Model.Id;

                $.ajax({
                    url: '@Url.Action("AddComment", "Post")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        UserName: userName,
                        Content: content,
                        PostId: postId
                    }),

                    success: function(response) {

                        $("#commentForm")[0].reset();

                        $("#comments-section").append(`
                                    <div class="card mb-3 shadow-sm">
                                        <div class="card-body">
                                            <h5 class="card-title">${response.username}</h5>
                                            <p class="card-text text-muted">${response.commentDate}</p>
                                            <p class="card-text">${response.content}</p>
                                        </div>
                                    </div>
                                `);
                    },

                    error: function(xhr) {
                        console.log(xhr.responseText);
                        alert("Failed to add comment.");
                    }
                });

            });

        });
    </script>
}
